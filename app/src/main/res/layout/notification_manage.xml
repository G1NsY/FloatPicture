<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center"
    android:padding="5dp">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:gravity="center"
        android:padding="2dp">

        <ImageView
            android:id="@+id/imageview_notification_application"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@string/imageview_app_icon"
            app:srcCompat="@mipmap/ic_launcher" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4.2"
        android:gravity="center|start"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/textview_picture_num"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_picture_count"
            android:textSize="12sp"
            android:typeface="sans" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="4.0"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp">

        <ImageView
            android:id="@+id/imageview_previous_picture"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/imageview_notification_previous"
            android:focusable="true"
            android:padding="7dp"
            android:src="@android:drawable/ic_media_previous" />

        <ImageView
            android:id="@+id/imageview_set_picture_view"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/imageview_notification_visible"
            android:focusable="true"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_invisible" />

        <ImageView
            android:id="@+id/imageview_next_picture"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/imageview_notification_next"
            android:focusable="true"
            android:padding="7dp"
            android:src="@android:drawable/ic_media_next" />

        <ImageView
            android:id="@+id/imageview_save_gesture"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/imageview_notification_save_gesture"
            android:focusable="true"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_save"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
