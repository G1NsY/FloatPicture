    <string name="support_qr_description">Alipay collection QR code provided by the developer</string>
    <string name="support_qr_hint">Take a screenshot, then open Scan in Alipay and select it from your album.</string>
    <string name="support_close_qr">Back to support</string>
    <string name="support_payment_note">View the full image and take a screenshot. In Alipay, open Scan and choose the screenshot from your album. Check the recipient and amount before paying. FloatPicture 2 does not process payments, receive payment credentials or unlock features based on support.</string>
    <string name="support_other_ways_title">Every contribution matters</string>
    <string name="support_other_ways_message">Sharing the app with people who need it, describing problems clearly, and suggesting improvements also help the project grow.\n\nYou never need to pay to use the app’s features.</string>
    <string name="support_thanks">Thank you for your encouragement and support.</string>
