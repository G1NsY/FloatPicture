<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#FF42A5F5"
                android:dashWidth="4dp"
                android:dashGap="3dp" />
        </shape>
    </item>
    <item
        android:left="9dp"
        android:top="9dp"
        android:right="9dp"
        android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#FF42A5F5" />
        </shape>
    </item>
    <item
        android:left="13dp"
        android:top="2dp"
        android:right="13dp"
        android:bottom="2dp">
        <rotate
            android:fromDegrees="-45"
            android:toDegrees="-45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#FF42A5F5" />
                <corners android:radius="1dp" />
            </shape>
        </rotate>
    </item>
</layer-list>
